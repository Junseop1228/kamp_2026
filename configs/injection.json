{
  "dataset": "injection",
  "rename": {
    "Unnamed: 0": "product_id",
    "PassOrFail": "label"
  },
  "data": {
    "train": {
      "CN7": "data/raw/injection/moldset_labeled_cn7.csv",
      "RG3": "data/raw/injection/moldset_labeled_rg3.csv"
    },
    "test": {
      "CN7": "data/raw/injection/moldset_unlabeled_cn7.csv",
      "RG3": "data/raw/injection/moldset_unlabeled_rg3.csv"
    }
  },
  "cv": {
    "max_folds": 5
  },
  "threshold": {
    "main_k": "defect_rate",
    "aux_k": "auto_group_size",
    "tie_rule": "include_all",
    "rounding": "half_up",
    "min_flag": 1
  },
  "limitations": [
    "labeled와 unlabeled 파일은 표준화 기준이 서로 다르다. 보정하지 않고 기록만 한다(D-004)."
  ]
}
